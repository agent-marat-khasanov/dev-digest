node_modules/
dist/
# agent-runner ships as a JS GitHub Action — its bundled dist/ MUST be committed
# (GitHub runs action.yml `main: dist/index.js` as-is, with no build step).
!agent-runner/dist/
!agent-runner/dist/**
build/
.next/
out/
coverage/
*.tsbuildinfo
.env
.env.local
.DS_Store
.idea/
.turbo/
.pnpm-store/
*.log
.devdigest/cache/
clones/
playwright-report/
test-results/

# Recorded subagent dispatches (.claude/hooks/dispatch-observe.py). Raw session prompts —
# they can contain anything a user pasted, so this accumulates locally and is never committed.
.ai/observability/

# emdash worktree config (local)
.emdash.json

# Agent worktrees — transient. NOTE: 56 of these gitlinks are already tracked (added by b9dd72a),
# and .gitignore does not untrack anything; this only stops NEW ones being swept in by `git add -A`.
.claude/worktrees/
