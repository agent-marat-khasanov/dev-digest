# evals/ — harness eval knobs. Copy to .env only if you need to override; every value has a
# default and the local (subscription) path needs NOTHING set.
#
# See "Backends" and "Running headless / in CI" in README.md.

# subscription (default) — Claude Code login, API key stripped so nothing bills per token.
# openrouter                — required for any headless run (CI has no subscription).
EVAL_BACKEND=subscription

# Model under test. Anthropic ID on `subscription`; an OpenRouter slug on `openrouter`.
#   skills tier   → a cheap non-Anthropic model is fine (content tier calls OpenRouter directly)
#   agents tier   → must be an anthropic/* slug (the tool tier runs inside the Agent SDK)
#   workflow tier → same as agents
EVAL_MODEL=claude-haiku-4-5

# Judge model — deliberately a stronger family than the task, to soften self-preference.
EVAL_JUDGE_MODEL=claude-sonnet-5

# Required when EVAL_BACKEND=openrouter. Never commit a real key.
OPENROUTER_API_KEY=

# Point at a local translating proxy (e.g. LiteLLM) instead of OpenRouter.
# OPENROUTER_BASE_URL=http://localhost:4000

# Max agent turns per case.
EVAL_MAX_TURNS=8

# `benchmark` sets this to `baseline` to skip artifact injection — leave unset normally.
# EVAL_CONFIG=candidate

# Set to anything to suppress per-run trace spam during multi-run aggregation.
# EVAL_QUIET=1
